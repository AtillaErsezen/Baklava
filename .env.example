# Project URL: Supabase Dashboard > Connect.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Browser-safe key: Settings > API Keys > Publishable key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Trusted backend only. The existing agent reads the name SUPABASE_KEY.
# Never use this key in frontend code or paste it into chat.
SUPABASE_KEY=sb_secret_REPLACE_ME

# Tracking check (loads .env; synthetic scores, no paid ML calls):
# uv run --frozen --env-file .env python -m scripts.supabase_smoke --realtime
