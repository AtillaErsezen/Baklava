# Server-side configuration for the existing Modal + Nebius pipeline.
# Copy this file to .env in the repository root. Never use VITE_ prefixes for secrets.
NEBIUS_API_KEY=

# Alternatively authenticate on this machine with: uv run modal setup
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional integrations already supported by the agent.
SUPABASE_URL=
SUPABASE_KEY=
TAVILY_API_KEY=

# Optional overrides; defaults are defined in providers.py / modal_train.py.
# AGENT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# ML_FACTORY_GPU=0
